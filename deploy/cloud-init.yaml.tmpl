#cloud-config
# Singularity Node — headless GPU machine bootstrap (#172 one-click deploy).
#
# Rendered by the deploy pipeline with these variables:
#   ${SGL_VERSION}        pinned sgl release tag (e.g. v1.7.1) — MUST be on the
#                         orchestrator binary allowlist or the node can't serve
#   ${SGL_SHA256}         sha256 of the linux binary for that tag (fail-closed)
#   ${SGL_PROVISION_CODE} single-use registration code minted by the deploy API,
#                         bound to ${SGL_WALLET} (short-lived; the only secret-ish
#                         value here, and it's dead after first use)
#   ${SGL_WALLET}         buyer's operator wallet (base58 — case preserved)
#   ${SGL_TEE_TYPE}       linux_se (Standard) | nvidia_cc (Confidential)
#   ${MODEL_ID}           grid model id (e.g. llama-3.1-70b)
#   ${MODEL_URL}          GGUF download URL
#   ${MODEL_SHA256}       GGUF sha256 (fail-closed)
#   ${GPU_LAYERS}         layers to offload (99 = all)
#   ${CONTEXT_SIZE}       context window tokens
#   ${LLAMA_CPP_TAG}      pinned llama.cpp release tag with a Vulkan Linux build (e.g. b9867)
#   ${ORCH_URL}           https://grid.x402compute.cc
#
# Design notes:
#  - GPU acceleration uses llama.cpp's PREBUILT VULKAN binary, not a CUDA source build.
#    Cloud GPU images (Vultr, most providers) ship the NVIDIA DRIVER but NOT the CUDA
#    toolkit/nvcc, so `-DGGML_CUDA=ON` compiles FAIL and the node never registers (the
#    original #172 failure). Vulkan needs only the loader (libvulkan1) + the driver's
#    Vulkan ICD, works on NVIDIA/AMD/Intel GPUs, and installs in ~1 min (no 10-min build).
#  - Everything installs under /opt/sgl. The bootstrap logs every step to
#    /var/log/sgl-bootstrap.log so a failed provision is DIAGNOSABLE (ssh in + read it),
#    not silent.
#  - The node keypair is generated ON this machine by `sgl login` — no private key
#    material ever transits user-data.
#  - Fail-closed: any checksum mismatch or step failure aborts the script; the deploy
#    pipeline sees the machine never register and marks the deployment failed.

package_update: true
packages:
  - curl
  - ca-certificates
  - libvulkan1
  - libgomp1

write_files:
  - path: /opt/sgl/bootstrap.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      # Log EVERYTHING to a file (and console) so a failed provision is never silent.
      exec > >(tee -a /var/log/sgl-bootstrap.log) 2>&1
      set -euxo pipefail
      echo "[sgl] bootstrap start $(date -u)"
      mkdir -p /opt/sgl/bin /opt/sgl/models /opt/sgl/dist

      # ── 1. llama.cpp (prebuilt Vulkan — GPU accel via the driver, no CUDA toolkit) ──
      curl -fsSL -o /opt/sgl/dist/llama.tgz \
        "https://github.com/ggml-org/llama.cpp/releases/download/${LLAMA_CPP_TAG}/llama-${LLAMA_CPP_TAG}-bin-ubuntu-vulkan-x64.tar.gz"
      tar xzf /opt/sgl/dist/llama.tgz -C /opt/sgl/dist
      SRV="$(find /opt/sgl/dist -type f -name llama-server | head -1)"
      test -n "$SRV"
      cp "$SRV" /opt/sgl/bin/llama-server
      chmod +x /opt/sgl/bin/llama-server
      # ALL shared libs AND ggml backends (libggml-vulkan.so, libggml-cpu*.so, libllama*,
      # libmtmd*) must sit NEXT TO the binary: newer llama.cpp dlopens its backends from the
      # executable's own directory (ggml_backend_load_all). Splitting them out = "no backends
      # loaded / no usable GPU". LD_LIBRARY_PATH (systemd unit) also points here for linking.
      find /opt/sgl/dist -type f -name '*.so*' -exec cp -a {} /opt/sgl/bin/ \;

      # ── 2. sgl node binary (pinned release, checksum fail-closed) ──
      curl -fsSL -o /opt/sgl/bin/sgl \
        "https://github.com/Singularity-Layer/sgl-network-node/releases/download/${SGL_VERSION}/sgl-linux-x86_64"
      echo "${SGL_SHA256}  /opt/sgl/bin/sgl" | sha256sum -c -
      chmod 0755 /opt/sgl/bin/sgl
      ln -sf /opt/sgl/bin/sgl /usr/local/bin/sgl

      # ── 3. Model (pinned GGUF, checksum fail-closed) ──
      curl -fsSL -o "/opt/sgl/models/${MODEL_ID}.gguf" "${MODEL_URL}"
      echo "${MODEL_SHA256}  /opt/sgl/models/${MODEL_ID}.gguf" | sha256sum -c -

      # ── 4. Headless registration (single-use code; keypair generated here) ──
      /opt/sgl/bin/sgl login \
        --code "${SGL_PROVISION_CODE}" --wallet "${SGL_WALLET}" \
        --tee-type "${SGL_TEE_TYPE}" --models "${MODEL_ID}" --orchestrator-url "${ORCH_URL}"

      # ── 5. Serve ──
      systemctl daemon-reload
      systemctl enable --now sgl-node.service
      echo "[sgl] bootstrap done $(date -u)"

  - path: /etc/systemd/system/sgl-node.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Singularity Grid Node
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      ExecStart=/opt/sgl/bin/sgl start \
        --model-path /opt/sgl/models/${MODEL_ID}.gguf \
        --model-name ${MODEL_ID} \
        --gpu-layers ${GPU_LAYERS} \
        --context-size ${CONTEXT_SIZE} \
        --orchestrator-url ${ORCH_URL}
      Restart=always
      RestartSec=10
      Environment=HOME=/root
      # The node spawns llama-server as a child; it inherits this so the Vulkan build finds
      # its bundled libs AND dlopens its GPU/CPU backends from this same directory.
      Environment=LD_LIBRARY_PATH=/opt/sgl/bin
      NoNewPrivileges=true
      PrivateTmp=true

      [Install]
      WantedBy=multi-user.target

runcmd:
  - bash /opt/sgl/bootstrap.sh
